# Database Configuration
DB_HOST=localhost
DB_PORT=6501
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=sanyukt

# Alternative PG env vars (used by SanyuktNamdev)
PGHOST=localhost
PGPORT=6501
PGUSER=postgres
PGPASSWORD=changeme
PGDATABASE=sanyukt

# PostgreSQL SSL mode: disable, require, verify-ca, verify-full
# Default: require (production safe)
PGSSLMODE=require

# JWT Secret - MUST be at least 32 characters for HS256
# Generate with: openssl rand -base64 32
JWT_SECRET=localdevsecret123456789012345678901234