# Create a New Achievement
POST {{api}}/achievements HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "John Doe",
  "achievement_type": "Academic",
  "achievement": "Gold Medal in Mathematics Olympiad",
  "description": "Awarded for outstanding performance in the International Mathematics Olympiad.",
  "date_of_achievement": "2024-02-01",
