###

# Get List of Achievements
GET {{api}}/achievements?page=1&limit=10 HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

###

# Find an Achievement by ID
GET {{api}}/achievements/{{achievementId}} HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

###

# Update an Achievement by ID
PUT {{api}}/achievements/{{achievementId}} HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "John Doe",
  "achievement_type": "Academic",
  "achievement": "Platinum Medal in Mathematics Olympiad",
  "description": "Updated: Won platinum medal in the International Mathematics Olympiad.",
  "date_of_achievement": "2024-02-05",
  "image": "https://example.com/new-image.jpg"
}

###

# Delete an Achievement by ID
DELETE {{api}}/achievements/{{achievementId}} HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

